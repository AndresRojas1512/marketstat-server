      "id": 100,
      "panels": [],
      "title": "ROW 1: BASELINE (EF Core LINQ)",
      "type": "row"
    },
    {
      "title": "1. Latency (P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"MarketStat.API.BASELINE\"}[1m])) by (le)) * 1000",
          "legendFormat": "P95 (ms)",
          "refId": "A",
          "color": "green"
        }
      ],
      "unit": "ms"
    },
    {
      "title": "2. Memory (Committed)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "process_runtime_dotnet_gc_committed_memory_size_bytes{service_name=\"MarketStat.API.BASELINE\"}",
          "legendFormat": "RAM",
          "refId": "A",
          "color": "blue"
        }
      ],
      "unit": "bytes",
      "fillOpacity": 25
    },
    {
      "title": "3. CPU Efficiency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "rate(process_cpu_time_seconds_total{service_name=\"MarketStat.API.BASELINE\"}[1m])", 
          "legendFormat": "BASELINE Cores",
          "refId": "A",
          "color": "green"
        }
      ],
      "unit": "none"
    },
    {
      "title": "4. Garbage (GC Pause)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "rate(process_runtime_dotnet_gc_duration_nanoseconds_total{service_name=\"MarketStat.API.BASELINE\"}[1m])",
          "legendFormat": "Pause Time/Sec",
          "refId": "A",
          "color": "red"
        }
      ],
      "unit": "ns"
    },



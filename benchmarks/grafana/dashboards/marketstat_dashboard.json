    },
    {
      "title": "Total Cores Used",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "sum by (service_name) (rate(process_cpu_time_seconds_total{service_name=\"MarketStat.API.BASELINE\"}[1m]))",
          "legendFormat": "BASELINE (EF Linq)",
          "refId": "A",
          "color": "green"
        },
        {
          "expr": "sum by (service_name) (rate(process_cpu_time_seconds_total{service_name=\"MarketStat.API.EF_SQL\"}[1m]))",
          "legendFormat": "EF SQL (Raw)",
          "refId": "B",
          "color": "yellow"
        },
        {
          "expr": "sum by (service_name) (rate(process_cpu_time_seconds_total{service_name=\"MarketStat.API.DAPPER\"}[1m]))",
          "legendFormat": "DAPPER",
          "refId": "C",
          "color": "blue"
        }
      ],
      "unit": "none"
    },



      "id": 100,
      "panels": [],
      "title": "1: P95 LATENCY",
      "type": "row"
    },
    {
      "title": "P95 Latency Comparison",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"MarketStat.API.BASELINE\"}[1m])) by (le)) * 1000",
          "legendFormat": "BASELINE (EF Linq)",
          "refId": "A",
          "color": "green"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"MarketStat.API.EF_SQL\"}[1m])) by (le)) * 1000",
          "legendFormat": "EF SQL (Raw)",
          "refId": "B",
          "color": "yellow"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"MarketStat.API.DAPPER\"}[1m])) by (le)) * 1000",
          "legendFormat": "DAPPER",
          "refId": "C",
          "color": "blue"
        }
      ],
      "unit": "ms"
    },


    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 200,
      "panels": [],
      "title": "2: MEMORY USAGE",
      "type": "row"
    },
    {
      "title": "Committed Memory Comparison",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "process_runtime_dotnet_gc_committed_memory_size_bytes{service_name=\"MarketStat.API.BASELINE\"}",
          "legendFormat": "BASELINE (EF Linq)",
          "refId": "A",
          "color": "green"
        },
        {
          "expr": "process_runtime_dotnet_gc_committed_memory_size_bytes{service_name=\"MarketStat.API.EF_SQL\"}",
          "legendFormat": "EF SQL (Raw)",
          "refId": "B",
          "color": "yellow"
        },
        {
          "expr": "process_runtime_dotnet_gc_committed_memory_size_bytes{service_name=\"MarketStat.API.DAPPER\"}",
          "legendFormat": "DAPPER",
          "refId": "C",
          "color": "blue"
        }
      ],
      "unit": "bytes",
      "fillOpacity": 10
    },


    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
